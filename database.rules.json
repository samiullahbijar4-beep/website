{
  "rules": {
    "words": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "languages": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "team": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "feedback": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": true
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    }
  },
  "comment": "Use these secure rules after creating the admin UID. See README.md."
}